<div class="max-w-2xl mx-auto px-4 py-8" data-controller="compose">
  <h1 class="text-2xl font-bold text-center mb-6">🎵 Brew Tune</h1>

  <%# テンポ選択 %>
  <div class="flex justify-center gap-3 mb-6">
    <span class="text-sm font-medium self-center">BPM</span>
    <% [60, 80, 100].each do |bpm| %>
      <button
        data-action="click->compose#selectBpm"
        data-bpm="<%= bpm %>"
        data-compose-target="bpmButton"
        class="px-4 py-1 rounded-full border text-sm font-medium transition
               <%= bpm == 80 ? 'bg-indigo-600 text-white border-indigo-600' : 'border-gray-400 text-gray-700 hover:border-indigo-400' %>">
        <%= bpm %>
      </button>
    <% end %>
  </div>

  <%# 16マスグリッド %>
  <div class="grid grid-cols-16 gap-1 mb-6" data-compose-target="grid">
    <% 16.times do |i| %>
      <div data-compose-target="cell"
           class="h-10 rounded border-2 border-dashed border-gray-300 flex items-center justify-center text-xs text-gray-400">
      </div>
    <% end %>
  </div>

  <%# ピアノ鍵盤 %>
  <div class="relative flex mb-6 select-none" data-compose-target="keyboard">
    <%
      white_keys = %w[C4 D4 E4 F4 G4 A4 B4 C5 D5 E5 F5 G5 A5 B5 C6]
      black_keys = {
        1 => "C#4", 2 => "D#4", 4 => "F#4", 5 => "G#4", 6 => "A#4",
        8 => "C#5", 9 => "D#5", 11 => "F#5", 12 => "G#5", 13 => "A#5"
      }
    %>
    <% white_keys.each_with_index do |note, i| %>
      <button
        data-action="click->compose#addNote"
        data-note="<%= note %>"
        class="relative flex-1 h-28 bg-white border border-gray-400 rounded-b-md hover:bg-indigo-100 active:bg-indigo-200 z-0">
        <span class="absolute bottom-1 left-0 right-0 text-center text-xs text-gray-400"><%= note %></span>
        <% if black_keys[i] %>
          <button
            data-action="click->compose#addNote"
            data-note="<%= black_keys[i] %>"
            class="absolute -right-[30%] top-0 w-[60%] h-16 bg-gray-900 rounded-b-md z-10 hover:bg-indigo-900 active:bg-indigo-700">
          </button>
        <% end %>
      </button>
    <% end %>
  </div>

  <%# 操作ボタン %>
  <div class="flex justify-center gap-4 mb-8">
    <button data-action="click->compose#clear"
            class="px-5 py-2 rounded border border-gray-400 text-gray-700 hover:bg-gray-100 text-sm">
      クリア
    </button>
  </div>

  <%# 投稿フォーム %>
  <%= form_with model: @melody, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :nickname, "ニックネーム", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nickname, placeholder: "例: おんぷ太郎",
          class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
    </div>
    <%= f.hidden_field :bpm, data: { compose_target: "bpmInput" }, value: 80 %>
    <div data-compose-target="notesContainer"></div>
    <button type="submit"
            class="w-full bg-indigo-600 text-white py-2 rounded font-medium hover:bg-indigo-700 transition">
      投稿する
    </button>
  <% end %>
</div>
