<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">🎵 メロディを編集</h1>
    <%= link_to "← 詳細に戻る", melody_path(@melody), class: "text-sm text-indigo-600 hover:underline" %>
  </div>

  <%# 曲のプレビュー（変更不可）%>
  <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6"
       data-controller="playback"
       data-playback-notes-value="<%= @melody.notes.to_json %>"
       data-playback-bpm-value="<%= @melody.bpm %>">
    <p class="text-xs text-gray-500 mb-2 font-medium">曲のデータ（編集不可）</p>
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs text-gray-500">BPM <%= @melody.bpm %></span>
      <span class="text-xs text-gray-400">·</span>
      <span class="text-xs text-gray-500"><%= @melody.notes.count { |n| n["pitch"] != "R" } %> 音</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(32, minmax(0, 1fr)); gap: 2px; overflow: hidden; margin-bottom: 0.75rem;">
      <% 32.times do |i| %>
        <% note = @melody.notes[i] %>
        <% if note.nil? %>
          <div style="height:1.25rem;min-width:0;overflow:hidden;border-radius:2px;background:#f3f4f6;border:1px solid #e5e7eb;"></div>
        <% elsif note["pitch"] == "R" %>
          <div style="height:1.25rem;min-width:0;overflow:hidden;border-radius:2px;background:#e5e7eb;border:1px solid #d1d5db;display:flex;align-items:center;justify-content:center;font-size:0.4rem;color:#9ca3af;font-family:sans-serif;">休</div>
        <% else %>
          <div style="height:1.25rem;min-width:0;overflow:hidden;border-radius:2px;background:#c7d2fe;border:1px solid #818cf8;display:flex;align-items:center;justify-content:center;font-size:0.4rem;color:#3730a3;font-weight:600;font-family:sans-serif;letter-spacing:-0.03em;"><%= note["pitch"] %></div>
        <% end %>
      <% end %>
    </div>
    <button data-action="click->playback#toggle"
            data-playback-target="playButton"
            class="px-4 py-1.5 bg-indigo-600 text-white text-xs rounded hover:bg-indigo-700 transition">
      ▶ 再生
    </button>
  </div>

  <%# 編集フォーム（名前・BPM・タグ・曲名）%>
  <%= form_with model: @melody, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :bpm, "BPM", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="flex flex-wrap gap-2" id="bpm-buttons">
        <% [100, 120, 150, 180, 240, 300, 360].each do |bpm| %>
          <button type="button"
                  onclick="(function(btn){
                    document.querySelectorAll('#bpm-buttons button').forEach(function(b){
                      b.style.background=''; b.style.color=''; b.style.borderColor='';
                    });
                    btn.style.background='#4f46e5'; btn.style.color='white'; btn.style.borderColor='#4f46e5';
                    document.getElementById('bpm-input').value=btn.dataset.bpm;
                  })(this)"
                  data-bpm="<%= bpm %>"
                  style="padding:0.25rem 0.75rem;border-radius:9999px;border:1px solid <%= @melody.bpm == bpm ? '#4f46e5' : '#9ca3af' %>;background:<%= @melody.bpm == bpm ? '#4f46e5' : 'white' %>;color:<%= @melody.bpm == bpm ? 'white' : '#374151' %>;font-size:0.875rem;font-weight:500;cursor:pointer;">
            <%= bpm %>
          </button>
        <% end %>
      </div>
      <%= f.hidden_field :bpm, id: "bpm-input" %>
    </div>
    <div>
      <%= f.label :nickname, "ニックネーム", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nickname,
          class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
    </div>

    <div>
      <%= f.label :theme, "曲のテーマ（任意）", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if @themes.any? %>
        <div class="flex flex-wrap gap-2 mb-2" data-controller="tagpicker">
          <% @themes.each do |theme| %>
            <button type="button"
                    onclick="(function(btn){
                      var inp = btn.closest('[data-controller]').nextElementSibling.querySelector('input');
                      var tags = inp.value.split(/\s*\/\s*/).map(s=>s.trim()).filter(Boolean);
                      var idx = tags.indexOf(btn.dataset.tag);
                      if(idx>=0){tags.splice(idx,1)}else{tags.push(btn.dataset.tag)}
                      inp.value = tags.join(' / ');
                      btn.style.background = idx<0 ? '#4f46e5' : '';
                      btn.style.color = idx<0 ? 'white' : '';
                      btn.style.borderColor = idx<0 ? '#4f46e5' : '';
                    })(this)"
                    data-tag="<%= theme %>"
                    class="px-3 py-1 text-xs rounded-full border border-indigo-300 text-indigo-600 hover:bg-indigo-50 transition">
              <%= theme %>
            </button>
          <% end %>
        </div>
      <% end %>
      <div>
        <%= f.text_field :theme,
            placeholder: "例: 明るい / 癒し",
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
      </div>
    </div>

    <div>
      <%= f.label :title, "曲名（任意）", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title,
          placeholder: "例: 春の小川",
          class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
    </div>

    <button type="submit"
            class="w-full bg-indigo-600 text-white py-2 rounded font-medium hover:bg-indigo-700 transition">
      更新する
    </button>
  <% end %>
</div>
