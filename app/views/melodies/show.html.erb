<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">🎵 Brew Tune</h1>
    <%= link_to "← 一覧に戻る", melodies_path, class: "text-sm text-indigo-600 hover:underline" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6"
       data-controller="playback"
       data-playback-notes-value="<%= @melody.notes.to_json %>"
       data-playback-bpm-value="<%= @melody.bpm %>">

    <%# タイトル・メタ情報 %>
    <div class="mb-4">
      <% if @melody.title.present? %>
        <h2 class="text-xl font-bold text-gray-900 mb-1"><%= @melody.title %></h2>
      <% end %>
      <div class="flex flex-wrap items-center gap-2 text-sm text-gray-600">
        <span class="font-medium"><%= @melody.nickname %></span>
        <span class="text-gray-400">·</span>
        <span>BPM <%= @melody.bpm %></span>
        <span class="text-gray-400">·</span>
        <span class="text-xs text-gray-400"><%= @melody.created_at.strftime("%Y/%m/%d") %></span>
        <% if @melody.theme.present? %>
          <% @melody.theme.split(/\s*\/\s*/).map(&:strip).each do |tag| %>
            <%= link_to melodies_path(theme: tag),
                class: "px-2 py-0.5 text-xs rounded-full bg-indigo-100 text-indigo-600 border border-indigo-200 hover:bg-indigo-200 transition" do %>
              # <%= tag %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# ノートグリッド %>
    <div style="display: grid; grid-template-columns: repeat(32, minmax(0, 1fr)); gap: 2px; overflow: hidden; margin-bottom: 1rem;">
      <% 32.times do |i| %>
        <% note = @melody.notes[i] %>
        <% if note.nil? %>
          <div style="height:1.75rem;min-width:0;overflow:hidden;border-radius:3px;background:#f3f4f6;border:1px solid #e5e7eb;"></div>
        <% elsif note["pitch"] == "R" %>
          <div style="height:1.75rem;min-width:0;overflow:hidden;border-radius:3px;background:#e5e7eb;border:1px solid #d1d5db;display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:#9ca3af;font-family:sans-serif;">休</div>
        <% else %>
          <div style="height:1.75rem;min-width:0;overflow:hidden;border-radius:3px;background:#c7d2fe;border:1px solid #818cf8;display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:#3730a3;font-weight:600;font-family:sans-serif;letter-spacing:-0.03em;"><%= note["pitch"] %></div>
        <% end %>
      <% end %>
    </div>

    <%# 音色・再生 %>
    <div class="flex items-center gap-3 mb-6">
      <div class="flex rounded overflow-hidden border border-gray-200 text-xs">
        <button
          data-action="click->playback#selectSoundType"
          data-sound-type="synth"
          data-playback-target="soundTypeButton"
          style="padding:4px 12px;background:#e0e7ff;color:#4338ca;border-right:1px solid #d1d5db;">
          シンセ
        </button>
        <button
          data-action="click->playback#selectSoundType"
          data-sound-type="piano"
          data-playback-target="soundTypeButton"
          style="padding:4px 12px;background:white;color:#6b7280;">
          ピアノ
        </button>
      </div>
      <button data-action="click->playback#toggle"
              data-playback-target="playButton"
              class="px-5 py-2 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700 transition font-medium">
        ▶ 再生
      </button>
    </div>

    <%# アクションボタン %>
    <div class="flex flex-wrap gap-3">
      <%= link_to edit_melody_path(@melody),
          class: "px-4 py-2 text-sm rounded border border-gray-300 text-gray-700 hover:bg-gray-50 transition" do %>
        ✎ 編集
      <% end %>

      <%# X シェアボタン %>
      <% tweet_text = @melody.title.present? ? "🎵 「#{@melody.title}」をBrewTuneで作りました！" : "🎵 BrewTuneでメロディを作りました！" %>
      <% tweet_url = melody_url(@melody) %>
      <%= link_to "https://twitter.com/intent/tweet?text=#{CGI.escape(tweet_text + " #BrewTune")}&url=#{CGI.escape(tweet_url)}",
          target: "_blank", rel: "noopener noreferrer",
          class: "px-4 py-2 text-sm rounded bg-black text-white hover:bg-gray-800 transition flex items-center gap-1" do %>
        <span style="font-weight:700;font-size:0.85rem;">𝕏</span> でシェア
      <% end %>

      <%= button_to "削除", melody_path(@melody), method: :delete,
          data: { turbo_confirm: "削除しますか？" },
          class: "px-4 py-2 text-sm rounded border border-red-300 text-red-500 bg-white hover:bg-red-50 transition cursor-pointer" %>
    </div>
  </div>
</div>
