<div class="max-w-2xl mx-auto px-4 pt-4 pb-8 py-10"> <%# ← 外側に大きな余白を追加 %>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">🎵 Brew Tune</h1>
    <%= link_to "← 一覧に戻る", melodies_path,
        style: "padding:0.5rem 1.25rem;background:#4f46e5;color:white;border-radius:0.375rem;font-size:0.875rem;font-weight:500;text-decoration:none;" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8"
       data-controller="playback"
       data-playback-notes-value="<%= @melody.notes.to_json %>"
       data-playback-bpm-value="<%= @melody.bpm %>">

    <%# タイトル・メタ情報 %>
    <div class="mb-4 space-y-1">
      <% if @melody.title.present? %>
        <div class="flex items-baseline gap-2">
          <span class="text-xs text-gray-400">曲名：</span>
          <span class="text-xl font-bold text-gray-900"><%= @melody.title %></span>
        </div>
      <% end %>
      <div class="flex items-center gap-2 text-sm text-gray-600">
        <span class="text-xs text-gray-400">ニックネーム：</span>
        <span class="font-medium"><%= @melody.nickname %></span>
      </div>
      <div class="flex items-center gap-2 text-sm text-gray-600">
        <span>BPM <%= @melody.bpm %></span>
        <span class="text-gray-400">·</span>
        <span class="text-xs text-gray-400"><%= @melody.created_at.strftime("%Y/%m/%d") %></span>
      </div>
      <% if @melody.theme.present? %>
        <div class="flex flex-wrap items-center gap-1">
          <span class="text-xs text-gray-400">テーマ：</span>
          <% @melody.theme.split(/\s*\/\s*/).map(&:strip).each do |tag| %>
            <%= link_to melodies_path(theme: tag),
                class: "px-2 py-0.5 text-xs rounded-full bg-indigo-100 text-indigo-600 border border-indigo-200 hover:bg-indigo-200 transition" do %>
              # <%= tag %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ノートグリッド %>
    <div style="display: grid; grid-template-columns: repeat(32, minmax(0, 1fr)); gap: 2px; overflow: hidden; margin-bottom: 1rem;">
      <% 32.times do |i| %>
        <% note = @melody.notes[i] %>
        <% if note.nil? %>
          <div style="height:1.75rem;min-width:0;overflow:hidden;border-radius:3px;background:#f3f4f6;border:1px solid #e5e7eb;"></div>
        <% elsif note["pitch"] == "R" %>
          <div style="height:1.75rem;min-width:0;overflow:hidden;border-radius:3px;background:#e5e7eb;border:1px solid #d1d5db;display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:#9ca3af;font-family:sans-serif;">休</div>
        <% else %>
          <div style="height:1.75rem;min-width:0;overflow:hidden;border-radius:3px;background:#c7d2fe;border:1px solid #818cf8;display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:#3730a3;font-weight:600;font-family:sans-serif;letter-spacing:-0.03em;"><%= note["pitch"] %></div>
        <% end %>
      <% end %>
    </div>

<%# 音色：w-full を追加して確実に右寄せにします %>
    <div class="flex items-center justify-end gap-3 mb-4 w-full">
      <div class="flex rounded overflow-hidden border border-gray-200 text-xs">
        <button
          data-action="click->playback#selectSoundType"
          data-sound-type="synth"
          data-playback-target="soundTypeButton"
          style="padding:6px 16px;background:#e0e7ff;color:#4338ca;border-right:1px solid #d1d5db;font-size:0.875rem;">
          シンセ
        </button>
        <button
          data-action="click->playback#selectSoundType"
          data-sound-type="piano"
          data-playback-target="soundTypeButton"
          style="padding:6px 16px;background:white;color:#6b7280;font-size:0.875rem;">
          ピアノ
        </button>
      </div>
    </div>

    <%# アクションボタン %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to edit_melody_path(@melody),
          class: "px-4 py-2 text-xs rounded border border-gray-300 text-gray-700 hover:bg-gray-50 transition" do %>
        ✎ 編集
      <% end %>

      <%# 削除ボタン（インライン確認） %>
      <div id="delete-btn-area">
        <button type="button"
                onclick="document.getElementById('delete-btn-area').style.display='none';document.getElementById('delete-confirm-area').style.display='flex';"
                class="px-4 py-2 text-xs rounded border border-red-300 text-red-500 bg-white hover:bg-red-50 transition cursor-pointer">
          削除
        </button>
      </div>
      <div id="delete-confirm-area" style="display:none;" class="flex items-center gap-2">
        <span class="text-sm text-gray-600">本当に削除しますか？</span>
        <%= button_to "はい", melody_path(@melody), method: :delete,
            class: "px-3 py-1.5 text-sm rounded bg-red-500 text-white hover:bg-red-600 transition cursor-pointer" %>
        <button type="button"
                onclick="document.getElementById('delete-confirm-area').style.display='none';document.getElementById('delete-btn-area').style.display='block';"
                class="px-3 py-1.5 text-sm rounded border border-gray-300 text-gray-600 hover:bg-gray-50 transition">
          いいえ
        </button>
      </div>

      <div style="margin-left:auto;display:flex;align-items:center;gap:0.75rem;">
        <%# 再生ボタン %>
        <button data-action="click->playback#toggle"
                data-playback-target="playButton"
                class="px-5 py-2 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700 transition font-medium">
          ▶ 再生
        </button>

        <%# X シェアボタン %>
        <% tweet_text = @melody.title.present? ? "🎵 お気に入りの曲は「#{@melody.title}」！" : "🎵 BrewTuneのお気に入りの曲はこれ！" %>
        <% tweet_url = melody_url(@melody) %>
        <%= link_to "https://twitter.com/intent/tweet?text=#{CGI.escape(tweet_text + " #BrewTune")}&url=#{CGI.escape(tweet_url)}",
            target: "_blank", rel: "noopener noreferrer",
            style: "padding:8px 16px;background:#6b7280;color:white;border-radius:4px;font-size:0.875rem;text-decoration:none;display:inline-flex;align-items:center;gap:4px;" do %>
          <span style="font-weight:700;font-size:0.85rem;">𝕏</span> でシェア
        <% end %>
      </div>
    </div>
  </div>
</div>
