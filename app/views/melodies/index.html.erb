<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">🎵 みんなのメロディ</h1>
    <%= link_to "＋ 作曲する", new_melody_path,
        class: "px-4 py-2 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700 transition" %>
  </div>

  <%# テーマタグ一覧（クリックでフィルタ）%>
  <% if @themes.any? %>
    <div class="flex flex-wrap gap-2 mb-6">
      <% if @theme_filter.present? %>
        <%= link_to "# 全て", melodies_path,
            class: "px-3 py-1 text-xs rounded-full border border-gray-300 text-gray-500 hover:bg-gray-50 transition" %>
      <% end %>
      <% @themes.each do |theme| %>
        <%= link_to melodies_path(theme: theme),
            class: "px-3 py-1 text-xs rounded-full border transition " +
                   (@theme_filter == theme ? "bg-indigo-600 text-white border-indigo-600" : "bg-indigo-100 text-indigo-700 border-indigo-200 hover:bg-indigo-200") do %>
          # <%= theme %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @theme_filter.present? %>
    <p class="text-sm text-gray-500 mb-4">「<span class="font-medium text-indigo-600"># <%= @theme_filter %></span>」の検索結果</p>
  <% end %>

  <% if @melodies.empty? %>
    <p class="text-center text-gray-400 py-16">まだ投稿がありません</p>
  <% else %>
    <div class="space-y-4">
      <% @melodies.each do |melody| %>
        <div class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm cursor-pointer"
             data-controller="playback"
             data-playback-notes-value="<%= melody.notes.to_json %>"
             data-playback-bpm-value="<%= melody.bpm %>"
             onclick="if(!event.target.closest('button,a,form')){window.location='<%= melody_path(melody) %>'}">

          <div class="flex items-start justify-between mb-2">
            <div class="flex flex-wrap items-center gap-2">
              <%= link_to melody_path(melody), class: "hover:underline" do %>
                <% if melody.title.present? %>
                  <span class="font-semibold text-gray-900"><%= melody.title %></span>
                <% end %>
                <span class="font-medium text-gray-600"><%= melody.nickname %></span>
              <% end %>
              <span class="text-xs text-gray-400">BPM <%= melody.bpm %></span>
              <% if melody.theme.present? %>
                <% melody.theme.split(/\s*\/\s*/).map(&:strip).each do |tag| %>
                  <%= link_to melodies_path(theme: tag),
                      class: "px-2 py-0.5 text-xs rounded-full bg-indigo-100 text-indigo-600 border border-indigo-200 hover:bg-indigo-200 transition" do %>
                    # <%= tag %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
            <div class="flex items-center gap-2 shrink-0 ml-2">
              <span class="text-xs text-gray-400"><%= melody.created_at.strftime("%Y/%m/%d") %></span>
              <%# 音色切替 %>
              <div class="flex rounded overflow-hidden border border-gray-200 text-xs">
                <button
                  data-action="click->playback#selectSoundType"
                  data-sound-type="synth"
                  data-playback-target="soundTypeButton"
                  style="padding:2px 8px;background:#e0e7ff;color:#4338ca;border-color:#a5b4fc;border-right:1px solid #d1d5db;">
                  シンセ
                </button>
                <button
                  data-action="click->playback#selectSoundType"
                  data-sound-type="piano"
                  data-playback-target="soundTypeButton"
                  style="padding:2px 8px;background:white;color:#6b7280;border-color:#d1d5db;">
                  ピアノ
                </button>
              </div>
              <button data-action="click->playback#toggle"
                      data-playback-target="playButton"
                      class="px-3 py-1 bg-indigo-600 text-white text-xs rounded hover:bg-indigo-700 transition">
                ▶ 再生
              </button>
              <% tweet_text = melody.title.present? ? "🎵 「#{melody.title}」をBrewTuneで作りました！" : "🎵 BrewTuneでメロディを作りました！" %>
              <%= link_to "https://twitter.com/intent/tweet?text=#{CGI.escape(tweet_text + " #BrewTune")}&url=#{CGI.escape(melody_url(melody))}",
                  target: "_blank", rel: "noopener noreferrer",
                  style: "padding:2px 10px;background:#6b7280;color:white;border-radius:4px;font-size:0.75rem;text-decoration:none;display:inline-flex;align-items:center;" do %>
                <span style="font-weight:700;">𝕏</span>
              <% end %>

            </div>
          </div>

          <%# ノートグリッド（32マス）%>
          <div style="display: grid; grid-template-columns: repeat(32, minmax(0, 1fr)); gap: 2px; overflow: hidden;">
            <% 32.times do |i| %>
              <% note = melody.notes[i] %>
              <% if note.nil? %>
                <div style="height:1.25rem;min-width:0;overflow:hidden;border-radius:2px;background:#f3f4f6;border:1px solid #e5e7eb;"></div>
              <% elsif note["pitch"] == "R" %>
                <div style="height:1.25rem;min-width:0;overflow:hidden;border-radius:2px;background:#e5e7eb;border:1px solid #d1d5db;display:flex;align-items:center;justify-content:center;font-size:0.4rem;color:#9ca3af;font-family:sans-serif;">休</div>
              <% else %>
                <div style="height:1.25rem;min-width:0;overflow:hidden;border-radius:2px;background:#c7d2fe;border:1px solid #818cf8;display:flex;align-items:center;justify-content:center;font-size:0.4rem;color:#3730a3;font-weight:600;font-family:sans-serif;letter-spacing:-0.03em;"><%= note["pitch"] %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
